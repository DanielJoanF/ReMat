# Database Connection (Supabase PostgreSQL / Local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/remat_db?schema=public"

# Supabase Auth & Storage Configuration
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Express API Server Port
PORT=4000
NODE_ENV=development

# Semantic Search Similarity Threshold (0.0 – 1.0)
# Minimum cosine similarity score for a result to be returned.
# Scores below this are treated as irrelevant noise and discarded.
# Default: 0.45  |  Recommended range: 0.40 – 0.60
# Note: short single-word queries (e.g. "besi") typically score 0.45–0.55
#       while multi-word/descriptive queries score 0.60+
SIMILARITY_THRESHOLD=0.45
