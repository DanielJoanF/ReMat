// schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

// =========================================
// ENUMS
// =========================================

enum UserRole {
  DISTRIBUTOR
  CONSUMER
  ADMIN
}

enum MaterialStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SOLD_OUT
  REJECTED
}

enum MaterialUnit {
  KG
  TON
  LITER
  PCS
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  TRANSFER
  VIRTUAL_ACCOUNT
  EWALLET
}

enum DocumentType {
  CERTIFICATE
  MSDS
  PHOTO
}

enum ChatRole {
  USER
  ASSISTANT
}

// =========================================
// USER & PROFILES
// =========================================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          UserRole
  name          String
  phone         String?
  isVerified    Boolean  @default(false) @map("is_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  distributorProfile DistributorProfile?
  consumerProfile    ConsumerProfile?
  bannersManaged     Banner[]

  @@map("users")
}

model DistributorProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  companyName        String   @map("company_name")
  companyType        String?  @map("company_type") // pabrik, hotel, RS, dll
  address            String
  province           String?
  city               String
  latitude           Float?
  longitude          Float?
  businessLicenseUrl String?  @map("business_license_url")
  isVerified         Boolean  @default(false) @map("is_verified")
  createdAt          DateTime @default(now()) @map("created_at")

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  materials      Material[]
  transactions   Transaction[]
  circularReports CircularReport[]
  ratingsReceived Rating[]

  @@map("distributor_profiles")
}

model ConsumerProfile {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  companyName  String?  @map("company_name")
  industryType String?  @map("industry_type") // daur ulang, UMKM, dll
  address      String?
  province     String?
  city         String?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now()) @map("created_at")

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  ratingsGiven  Rating[]
  conversations ChatConversation[]
  alerts        MaterialAlert[]

  @@map("consumer_profiles")
}

// =========================================
// CATEGORY & MATERIAL
// =========================================

model Category {
  id       String     @id @default(uuid())
  name     String
  slug     String     @unique
  parentId String?    @map("parent_id")
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")

  materials Material[]
  alerts    MaterialAlert[]

  @@map("categories")
}

model Material {
  id             String         @id @default(uuid())
  distributorId  String         @map("distributor_id")
  categoryId     String         @map("category_id")
  materialCode   String         @unique @map("material_code")
  title          String
  description    String
  qualityGrade   String?        @map("quality_grade")
  quantity       Float
  unit           MaterialUnit
  price          Float
  currency       String         @default("IDR")
  location       String
  latitude       Float?
  longitude      Float?
  status         MaterialStatus @default(DRAFT)
  requiresMsds   Boolean        @default(false) @map("requires_msds")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  distributor DistributorProfile @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  category    Category           @relation(fields: [categoryId], references: [id])
  documents   MaterialDocument[]
  embedding   MaterialEmbedding?
  items       TransactionItem[]

  @@index([categoryId])
  @@index([status])
  @@map("materials")
}

model MaterialDocument {
  id         String       @id @default(uuid())
  materialId String       @map("material_id")
  type       DocumentType
  fileUrl    String       @map("file_url")
  uploadedAt DateTime     @default(now()) @map("uploaded_at")

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@map("material_documents")
}

// Membutuhkan ekstensi pgvector. Dimensi vektor menyesuaikan model embedding yang dipakai
// (contoh: 1536 untuk text-embedding-3-small OpenAI, 768 untuk beberapa model Gemini).
model MaterialEmbedding {
  id             String   @id @default(uuid())
  materialId     String   @unique @map("material_id")
  embedding      Unsupported("vector(1536)")
  embeddingModel String   @map("embedding_model")
  updatedAt      DateTime @updatedAt @map("updated_at")

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@map("material_embeddings")
}

// =========================================
// TRANSACTION & PAYMENT
// =========================================

model Transaction {
  id                String             @id @default(uuid())
  consumerId        String             @map("consumer_id")
  distributorId     String             @map("distributor_id")
  status            TransactionStatus  @default(PENDING)
  totalAmount       Float              @map("total_amount")
  shippingAddress   String?            @map("shipping_address")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  consumer    ConsumerProfile    @relation(fields: [consumerId], references: [id])
  distributor DistributorProfile @relation(fields: [distributorId], references: [id])
  items       TransactionItem[]
  payment     Payment?
  rating      Rating?

  @@index([consumerId])
  @@index([distributorId])
  @@index([status])
  @@map("transactions")
}

model TransactionItem {
  id            String   @id @default(uuid())
  transactionId String   @map("transaction_id")
  materialId    String   @map("material_id")
  quantity      Float
  unitPrice     Float    @map("unit_price")
  subtotal      Float

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  material    Material    @relation(fields: [materialId], references: [id])

  @@map("transaction_items")
}

model Payment {
  id             String        @id @default(uuid())
  transactionId  String        @unique @map("transaction_id")
  method         PaymentMethod
  providerRefId  String?       @map("provider_ref_id")
  status         PaymentStatus @default(PENDING)
  amount         Float
  paidAt         DateTime?     @map("paid_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Rating {
  id             String   @id @default(uuid())
  transactionId  String   @unique @map("transaction_id")
  consumerId     String   @map("consumer_id")
  distributorId  String   @map("distributor_id")
  score          Int      // 1-5
  comment        String?
  createdAt      DateTime @default(now()) @map("created_at")

  transaction Transaction        @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  consumer    ConsumerProfile    @relation(fields: [consumerId], references: [id])
  distributor DistributorProfile @relation(fields: [distributorId], references: [id])

  @@map("ratings")
}

// =========================================
// AI: CIRCULAR REPORT, CHAT, ALERT
// =========================================

model CircularReport {
  id                    String   @id @default(uuid())
  distributorId         String   @map("distributor_id")
  period                String   // format "YYYY-MM"
  totalWasteUtilizedKg  Float    @map("total_waste_utilized_kg")
  wasteDiversionRate    Float    @map("waste_diversion_rate")
  carbonSavingKg        Float    @map("carbon_saving_kg")
  economicValue         Float    @map("economic_value")
  transactionCount      Int      @map("transaction_count")
  topMaterialId         String?  @map("top_material_id")
  circularScore         Float    @map("circular_score")
  aiSummary             String   @map("ai_summary") // narasi dari LLM
  generatedAt           DateTime @default(now()) @map("generated_at")

  distributor DistributorProfile @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@unique([distributorId, period])
  @@map("circular_reports")
}

model ChatConversation {
  id           String   @id @default(uuid())
  consumerId   String   @map("consumer_id")
  startedAt    DateTime @default(now()) @map("started_at")
  lastActiveAt DateTime @updatedAt @map("last_active_at")

  consumer ConsumerProfile @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@map("chat_conversations")
}

model ChatMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  role           ChatRole
  content        String
  contextUsed    Json?    @map("context_used") // material ids / filters yang direferensikan
  createdAt      DateTime @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model MaterialAlert {
  id             String   @id @default(uuid())
  consumerId     String   @map("consumer_id")
  categoryId     String?  @map("category_id")
  queryText      String   @map("query_text")
  locationFilter String?  @map("location_filter")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  consumer ConsumerProfile @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  category Category?       @relation(fields: [categoryId], references: [id])

  @@map("material_alerts")
}

// =========================================
// ADMIN
// =========================================

model Banner {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String   @map("image_url")
  linkUrl   String?  @map("link_url")
  isActive  Boolean  @default(true) @map("is_active")
  order     Int      @default(0)
  startAt   DateTime? @map("start_at")
  endAt     DateTime? @map("end_at")
  managedBy String?  @map("managed_by")

  manager User? @relation(fields: [managedBy], references: [id])

  @@map("banners")
}
